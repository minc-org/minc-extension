{
  "name": "minc",
  "repository": "https://github.com/minc-org/minc-extension",
  "homepage": "https://github.com/minc-org/minc-extension#readme",
  "displayName": "MicroShift",
  "description": "Integration for MicroShift: run local Kubernetes clusters using container “nodes”",
  "version": "0.5.0-next",
  "icon": "icon.png",
  "publisher": "minc-org",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "podman-desktop": "^1.17.0"
  },
  "main": "./dist/main.cjs",
  "contributes": {
    "configuration": {
      "title": "MicroShift",
      "properties": {
        "microshift.cluster.form.description": {
          "type": "markdown",
          "scope": "KubernetesProviderConnectionFactory",
          "markdownDescription": "A MicroShift cluster is created using custom ports for routes."
        },
        "microshift.cluster.creation.http.port": {
          "type": "number",
          "default": 80,
          "scope": "KubernetesProviderConnectionFactory",
          "description": "HTTP Port for the routes"
        },
        "microshift.cluster.creation.https.port": {
          "type": "number",
          "default": 443,
          "scope": "KubernetesProviderConnectionFactory",
          "description": "HTTPS Port for the routes"
        },
        "microshift.cluster.creation.allow.rootless": {
          "type": "boolean",
          "default": false,
          "scope": "KubernetesProviderConnectionFactory",
          "description": "Allow rootless Podman (Linux only). Requires host prerequisites (cpuset delegation and subordinate UID/GID ranges).",
          "when": "isLinux"
        }
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e": "cross-env DEBUG=pw:channel:response,pw:channel:event npm run test:e2e:setup && xvfb-maybe --auto-servernum --server-args='-screen 0 1280x960x24' -- npx playwright test",
    "format:check": "biome format",
    "format:fix": "biome format --write",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "vite build -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "inversify": "^8.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@podman-desktop/api": "^1.29.1",
    "@podman-desktop/podman-extension-api": "^1.29.0",
    "@podman-desktop/tests-playwright": "^1.29.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "commitlint": "^20.5.3",
    "concurrently": "^10.0.5",
    "cross-env": "10.1.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-redundant-undefined": "^1.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.2",
    "vitest": "^5.0.3",
    "xvfb-maybe": "^0.2.1"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
